# Скопируйте в .env и подставьте свои значения. Файл .env в репозиторий не попадает.
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=music_store

# Docker Compose: задайте уникальный DB_PASSWORD выше, не коммитьте .env.
# DB_HOST/DB_PORT/PORT для контейнеров заданы в Compose.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
APP_TAG=local
